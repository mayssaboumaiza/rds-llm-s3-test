# PostgreSQL RDS connection string
# Format: postgresql+psycopg2://user:password@host:5432/dbname
RDS_URL=

# Target S3 bucket name (must exist and be accessible with your AWS credentials)
S3_BUCKET=

# OpenAI API key — leave empty to run in mock/fallback mode
OPENAI_API_KEY=

# Optional: local path for the output CSV (default: ./output.csv)
OUTPUT_PATH=./output.csv
